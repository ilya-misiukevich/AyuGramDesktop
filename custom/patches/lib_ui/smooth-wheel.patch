+bool ElasticScroll::processSmoothWheel(
+		not_null<QWheelEvent*> e,
+		int delta,
+		bool touch) {
+	const auto angle = _vertical ? e->angleDelta().y() : e->angleDelta().x();
+	if (touch
+		|| !delta
+		|| std::abs(angle) != 120
+		|| e->modifiers() != Qt::NoModifier
+		|| _disabled) {
+		_smoothWheelAnimation.stop();
+		_smoothWheelLastApplied = std::nullopt;
+		return false;
+	}
+	auto animating = _smoothWheelAnimation.animating();
+	if (animating
+		&& _smoothWheelLastApplied
+		&& _state.visibleFrom != *_smoothWheelLastApplied
+		&& !smoothWheelFollowContent(
+			*_smoothWheelLastApplied,
+			_smoothWheelLastMax)) {
+		_smoothWheelAnimation.stop();
+		animating = false;
+	}
+	const auto base = animating ? _smoothWheelTarget : _state.visibleFrom;
+	const auto target = willScrollTo(base + delta);
+	if (!animating && target == base) {
+		return false;
+	}
+	_smoothWheelTarget = target;
+	_smoothWheelFrom = _state.visibleFrom;
+	_smoothWheelStart = crl::now();
+	_smoothWheelLastApplied = _state.visibleFrom;
+	_smoothWheelLastMax = smoothWheelMax();
+	if (!animating) {
+		_smoothWheelAnimation.start();
+	}
+	return true;
+}
+
+void ElasticScroll::smoothWheelStep(crl::time now) {
+	if (_smoothWheelLastApplied
+		&& _state.visibleFrom != *_smoothWheelLastApplied
+		&& !smoothWheelFollowContent(
+			*_smoothWheelLastApplied,
+			_smoothWheelLastMax)) {
+		_smoothWheelAnimation.stop();
+		_smoothWheelLastApplied = std::nullopt;
+		return;
+	}
+	const auto progress = std::clamp(
+		(now - _smoothWheelStart) / float64(kSmoothWheelDuration),
+		0.,
+		1.);
+	const auto value = anim::interpolate(
+		_smoothWheelFrom,
+		_smoothWheelTarget,
+		anim::easeOutQuint(1., progress));
+	const auto expected = willScrollTo(value);
+	const auto max = smoothWheelMax();
+	const auto weak = base::make_weak(this);
+	tryScrollTo(value);
+	if (!weak) {
+		return;
+	} else if (_state.visibleFrom != expected
+		&& !smoothWheelFollowContent(expected, max)) {
+		_smoothWheelAnimation.stop();
+		_smoothWheelLastApplied = std::nullopt;
+		return;
+	}
+	_smoothWheelLastApplied = _state.visibleFrom;
+	_smoothWheelLastMax = smoothWheelMax();
+	if (progress >= 1.) {
+		_smoothWheelAnimation.stop();
+		_smoothWheelLastApplied = std::nullopt;
+	}
+}
+
+int ElasticScroll::smoothWheelMax() const {
+	return _state.fullSize - (_state.visibleTill - _state.visibleFrom);
+}
+
+bool ElasticScroll::smoothWheelFollowContent(int position, int max) {
+	// The owner kept the view in place after the content above changed.
+	const auto shift = _state.visibleFrom - position;
+	if (!shift || (smoothWheelMax() - max) != shift) {
+		return false;
+	}
+	_smoothWheelFrom += shift;
+	_smoothWheelTarget += shift;
+	return true;
+}

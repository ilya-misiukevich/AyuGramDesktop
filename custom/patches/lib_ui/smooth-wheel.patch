+bool ScrollArea::processSmoothWheel(not_null<QWheelEvent*> e) {
+	const auto delta = e->angleDelta().y();
+	if (std::abs(delta) != 120
+		|| e->phase() != Qt::NoScrollPhase
+		|| e->modifiers() != Qt::NoModifier
+		|| _disabled) {
+		_smoothWheelAnimation.stop();
+		return false;
+	}
+	const auto single = verticalScrollBar()->singleStep()
+		* QApplication::wheelScrollLines();
+	auto animating = _smoothWheelAnimation.animating();
+	if (animating
+		&& _smoothWheelLastApplied >= 0
+		&& scrollTop() != _smoothWheelLastApplied
+		&& !smoothWheelFollowContent(
+			_smoothWheelLastApplied,
+			_smoothWheelLastMax)) {
+		_smoothWheelAnimation.stop();
+		animating = false;
+	}
+	const auto base = animating ? _smoothWheelTarget : scrollTop();
+	const auto target = std::clamp(
+		base + ((delta > 0) ? -single : single),
+		0,
+		scrollTopMax());
+	if (!animating && target == base) {
+		return false;
+	}
+	_smoothWheelTarget = target;
+	_smoothWheelFrom = scrollTop();
+	_smoothWheelStart = crl::now();
+	_smoothWheelLastApplied = scrollTop();
+	_smoothWheelLastMax = scrollTopMax();
+	if (!animating) {
+		_smoothWheelAnimation.start();
+	}
+	return true;
+}
+
+void ScrollArea::smoothWheelStep(crl::time now) {
+	if (_smoothWheelLastApplied >= 0
+		&& scrollTop() != _smoothWheelLastApplied
+		&& !smoothWheelFollowContent(
+			_smoothWheelLastApplied,
+			_smoothWheelLastMax)) {
+		_smoothWheelAnimation.stop();
+		_smoothWheelLastApplied = -1;
+		return;
+	}
+	const auto progress = std::clamp(
+		(now - _smoothWheelStart) / float64(kSmoothWheelDuration),
+		0.,
+		1.);
+	const auto value = anim::interpolate(
+		_smoothWheelFrom,
+		_smoothWheelTarget,
+		anim::easeOutQuint(1., progress));
+	const auto max = scrollTopMax();
+	const auto expected = std::clamp(value, 0, max);
+	scrollToY(value);
+	if (scrollTop() != expected
+		&& !smoothWheelFollowContent(expected, max)) {
+		_smoothWheelAnimation.stop();
+		_smoothWheelLastApplied = -1;
+		return;
+	}
+	_smoothWheelLastApplied = scrollTop();
+	_smoothWheelLastMax = scrollTopMax();
+	if (progress >= 1.) {
+		_smoothWheelAnimation.stop();
+		_smoothWheelLastApplied = -1;
+	}
+}
+
+bool ScrollArea::smoothWheelFollowContent(int position, int max) {
+	// The owner kept the view in place after the content above changed.
+	const auto shift = scrollTop() - position;
+	if (!shift || (scrollTopMax() - max) != shift) {
+		return false;
+	}
+	_smoothWheelFrom += shift;
+	_smoothWheelTarget += shift;
+	return true;
+}

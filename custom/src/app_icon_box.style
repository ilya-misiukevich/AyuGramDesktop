using "ui/basic.style";
using "ui/colors.palette";
using "ui/widgets/widgets.style";
using "ui/layers/layers.style";
using "settings/settings.style";

appIconPagePreviewTop: 28px;
appIconPagePreviewSize: 128px;
appIconPagePreviewCollapsed: 40px;
appIconPageNameSkip: 18px;
appIconPageNameHeight: 28px;
appIconPageSubtitleSkip: 6px;
appIconPageSubtitleHeight: 20px;
appIconPageHeroBottom: 40px;
appIconPageTextPadding: 24px;
appIconPageTextShift: 12px;
appIconPageName: FlatLabel(defaultFlatLabel) {
	textFg: boxTitleFg;
	align: align(top);
	minWidth: 32px;
	style: TextStyle(defaultTextStyle) {
		font: boxTitleFont;
	}
}
appIconPageSubtitle: FlatLabel(defaultFlatLabel) {
	textFg: windowSubTextFg;
	align: align(top);
	minWidth: 32px;
}
appIconPagePanelRadius: 20px;
appIconPageFadeHeight: 24px;
appIconPageFadeDistance: 16px;
appIconPageGridTop: 16px;
appIconPageGridBottom: 64px;
appIconPageGridPadding: margins(12px, 0px, 12px, 0px);
appIconPageColumnWidth: 100px;
appIconPageColumnMaxWidth: 112px;
appIconPageCaptionSkip: 4px;
appIconPageRowSkip: 8px;
appIconPageTabsSkip: 4px;

appIconSettingsButton: SettingsButton(settingsButton) {
	padding: margins(60px, 10px, 64px, 30px);
}
appIconSettingsSubtitle: FlatLabel(defaultFlatLabel) {
	textFg: windowSubTextFg;
}
appIconSettingsSubtitleTop: 31px;
appIconSettingsPreviewSize: 34px;
appIconSettingsPreviewRight: 22px;
